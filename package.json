{
  "name": "easybills",
  "version": "0.1.0",
  "private": true,
  "description": "Simple billing for very small Indian businesses",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json scripts/seed.ts",
    "worker": "tsx --tsconfig tsconfig.scripts.json src/worker/main.ts",
    "worker:once": "tsx --tsconfig tsconfig.scripts.json src/worker/main.ts --once",
    "emulators": "firebase emulators:start --only auth,firestore --project easybills-dev",
    "e2e": "node scripts/e2e-smoke.mjs",
    "gst:audit-rules": "tsx --tsconfig tsconfig.scripts.json scripts/audit-rule-pack.ts"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "next": "^16.3.6",
    "playwright-core": "^1.63.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "firebase-tools": "^15.31.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}