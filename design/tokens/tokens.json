{
  "$schema": "EkBill design tokens v1. Source of truth: edit this file, then run `python3 design/tokens/build.py` to regenerate themes.css and tokens.ts.",
  "meta": {
    "name": "EkBill",
    "version": "1.0.0",
    "themes": ["narangi", "harmony"],
    "defaultTheme": "narangi",
    "systemDark": "harmony",
    "fontFamily": "'Urbanist', system-ui, -apple-system, 'Segoe UI', sans-serif"
  },

  "shared": {
    "radius": {
      "hero": "36px",
      "card": "32px",
      "row": "22px",
      "field": "16px",
      "pill": "999px",
      "icon": "50%"
    },
    "space": {
      "gutter": "12px",
      "heading-gutter": "22px",
      "card-pad": "20px",
      "stack": "12px",
      "row-gap": "8px",
      "chip-gap": "8px"
    },
    "size": {
      "touch": "44px",
      "icon-btn": "44px",
      "cta": "62px",
      "field": "50px",
      "nav": "60px",
      "avatar": "38px"
    },
    "type": {
      "display": { "size": "36px", "weight": "300", "emphasis": "600", "tracking": "-0.025em", "line": "1.08" },
      "title":   { "size": "22px", "weight": "300", "emphasis": "600", "tracking": "-0.02em", "line": "1.15" },
      "card":    { "size": "17px", "weight": "500" },
      "body":    { "size": "15px", "weight": "500" },
      "meta":    { "size": "13px", "weight": "400" },
      "label":   { "size": "12px", "weight": "600" },
      "money-hero": { "size": "48px", "weight": "500", "tracking": "-0.03em", "rupee-size": "26px", "rupee-weight": "300" },
      "money-row":  { "size": "15px", "weight": "600" }
    },
    "semantic-fixed": {
      "whatsapp": "#25D366",
      "on-whatsapp": "#0B2A16",
      "invoice-paper": "#FFFFFF",
      "invoice-ink": "#16170F"
    }
  },

  "themes": {
    "narangi": {
      "label": { "hi-Latn": "Narangi", "en": "Narangi (light)" },
      "scheme": "light",
      "color": {
        "bg": "#EEEEEA",
        "bg-dots": "rgba(22,23,15,.07)",
        "bg-dots-size": "9px",
        "surface": "#FFFFFF",
        "surface-2": "#F4F4F0",
        "glass": "rgba(255,255,255,.88)",
        "glass-ring": "rgba(22,23,15,.05)",
        "text": "#16170F",
        "text-soft": "#45463E",
        "text-muted": "#5F6057",
        "line": "#E2E1DA",
        "divider": "#EFEFEA",
        "accent": "#FFB020",
        "on-accent": "#16170F",
        "ink-btn": "#16170F",
        "on-ink-btn": "#FFFFFF",
        "on-hero": "#FFFFFF",
        "on-panel": "#16170F",
        "panel-row": "rgba(255,255,255,.82)",
        "paid": "#1E6B3A",
        "paid-bg": "#E2F1DF",
        "due": "#B3261E",
        "due-bg": "#FBE5E1",
        "sent": "#45463E",
        "sent-bg": "#EFEEE8",
        "nav-bg": "rgba(255,255,255,.88)",
        "nav-fg": "#45463E",
        "nav-active-bg": "#FFB020",
        "nav-active-fg": "#16170F",
        "focus": "#16170F"
      },
      "gradient": {
        "hero": "radial-gradient(110% 70% at 100% 0%, #6B1F08 0%, rgba(107,31,8,0) 60%), radial-gradient(80% 60% at 0% 100%, #FFE2B8 0%, rgba(255,226,184,0) 70%), linear-gradient(170deg, #8A2C0B 0%, #C2410C 32%, #F2762E 62%, #FFA95C 86%, #FFE0BD 100%)",
        "hero-back": "none",
        "panel": "radial-gradient(90% 50% at 85% 0%, rgba(255,255,255,.9) 0%, rgba(255,255,255,0) 70%), linear-gradient(172deg, #A7A3EC 0%, #D8D3F7 26%, #F5EFF8 52%, #F4DDF0 78%, #EAB4DE 100%)",
        "gst": "radial-gradient(90% 60% at 100% 0%, #123E44 0%, rgba(18,62,68,0) 65%), radial-gradient(70% 55% at 0% 100%, #DCEBB8 0%, rgba(220,235,184,0) 70%), linear-gradient(165deg, #1C565D 0%, #2A7880 36%, #5FA8A2 66%, #A9D3B5 88%, #E2EDC4 100%)",
        "cta": "#FFB020",
        "screen-glow": "none",
        "headline-emphasis": "none"
      },
      "shadow": {
        "card": "0 1px 0 rgba(0,0,0,.03), 0 18px 30px -26px rgba(22,23,15,.35)",
        "hero": "0 24px 40px -28px rgba(160,60,10,.6)",
        "cta": "0 20px 30px -18px rgba(200,110,10,.7)",
        "nav": "0 18px 40px -18px rgba(22,23,15,.45)"
      },
      "avatar": [
        "linear-gradient(140deg, #FFE6C7, #FDB27A)",
        "linear-gradient(140deg, #F6DDF0, #D9B8F2)",
        "linear-gradient(140deg, #D6F0EE, #9CCFD3)",
        "linear-gradient(140deg, #E5E3FA, #B9B3F0)"
      ],
      "hero-style": "gradient-card"
    },

    "harmony": {
      "label": { "hi-Latn": "Harmony", "en": "Harmony (dark)" },
      "scheme": "dark",
      "color": {
        "bg": "#0B0E0D",
        "bg-dots": "rgba(255,255,255,.06)",
        "bg-dots-size": "14px",
        "surface": "rgba(255,255,255,.06)",
        "surface-2": "rgba(255,255,255,.10)",
        "glass": "rgba(23,28,26,.92)",
        "glass-ring": "rgba(255,255,255,.08)",
        "text": "#F2F5F2",
        "text-soft": "#C9D0CB",
        "text-muted": "#9AA39C",
        "line": "rgba(255,255,255,.14)",
        "divider": "rgba(255,255,255,.07)",
        "accent": "#68E78E",
        "on-accent": "#0B0E0D",
        "ink-btn": "#F2F5F2",
        "on-ink-btn": "#0B0E0D",
        "on-hero": "#FFFFFF",
        "on-panel": "#F2F5F2",
        "panel-row": "rgba(255,255,255,.10)",
        "paid": "#68E78E",
        "paid-bg": "rgba(104,231,142,.14)",
        "due": "#FF8A80",
        "due-bg": "rgba(255,120,110,.14)",
        "sent": "#C9D0CB",
        "sent-bg": "rgba(255,255,255,.08)",
        "nav-bg": "rgba(23,28,26,.92)",
        "nav-fg": "#B8C0BA",
        "nav-active-bg": "rgba(255,255,255,.09)",
        "nav-active-fg": "#F2F5F2",
        "focus": "#68E78E",
        "brand-charcoal": "#000B1A"
      },
      "gradient": {
        "hero": "radial-gradient(80% 30% at 85% 0%, rgba(255,255,255,.12) 0%, rgba(255,255,255,0) 70%), linear-gradient(180deg, #3E8650 0%, #3A7E4B 50%, #336F42 100%)",
        "hero-back": "linear-gradient(180deg, #27573A 0%, #1E4530 100%)",
        "panel": "rgba(255,255,255,.06)",
        "gst": "radial-gradient(80% 30% at 85% 0%, rgba(255,255,255,.12) 0%, rgba(255,255,255,0) 70%), linear-gradient(180deg, #2A7880 0%, #1F5E66 100%)",
        "cta": "radial-gradient(60% 120% at 50% 50%, #1D3F26 0%, #2F6B3A 40%, #4FB36A 80%, #68E78E 100%)",
        "screen-glow": "radial-gradient(70% 28% at 100% 0%, rgba(104,231,142,.16) 0%, rgba(104,231,142,0) 70%)",
        "headline-emphasis": "linear-gradient(90deg, #68E78E, #DDF7E4)"
      },
      "shadow": {
        "card": "inset 0 0 0 1px rgba(255,255,255,.08)",
        "hero": "0 30px 50px -30px rgba(104,231,142,.45)",
        "cta": "inset 0 1px 0 rgba(255,255,255,.25), 0 20px 40px -18px rgba(104,231,142,.6)",
        "nav": "inset 0 0 0 1px rgba(255,255,255,.08), 0 20px 40px -16px rgba(0,0,0,.8)"
      },
      "avatar": [
        "linear-gradient(140deg, #DDF7E4, #68E78E)",
        "linear-gradient(140deg, #FFFFFF, #BFC9C2)",
        "linear-gradient(140deg, #CFF3E6, #7FD1B4)",
        "linear-gradient(140deg, #E8F6C9, #A9D97A)"
      ],
      "hero-style": "folder"
    }
  }
}
