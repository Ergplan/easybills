# ---------------------------------------------------------------------------
# EasyBills environment configuration
#
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# Values marked PUBLIC are shipped to the browser and are safe to expose;
# everything else is server-only.
# ---------------------------------------------------------------------------

# --- Firebase project ------------------------------------------------------
FIREBASE_PROJECT_ID=easybills-dev

# PUBLIC: the Firebase Web config identifies the project to the browser. It is
# not a secret -- Firestore rules deny all direct client access, and every
# business record is reached through this app's own server.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=easybills-dev
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server credentials. In production prefer Application Default Credentials
# (GOOGLE_APPLICATION_CREDENTIALS, or the metadata server on Google infra).
# FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

# --- Local emulator (development only) -------------------------------------
# When these are set the app talks to the local Firebase emulator suite and
# ignores any real credentials. Leave them UNSET in production.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Application -----------------------------------------------------------
SESSION_MAX_AGE_MS=432000000

# Shared secret the background job runner must present. Generate a long random
# value: openssl rand -hex 32
JOB_RUNNER_SECRET=change-me-to-a-long-random-value

# --- AI assistance (optional) ----------------------------------------------
# The app is fully usable with AI switched off. "mock" is a deterministic local
# adapter for development and tests; it is never silently substituted for a
# configured provider.
AI_ENABLED=true
AI_LLM_PROVIDER=mock            # mock | anthropic | openai | google
AI_LLM_MODEL=
AI_LLM_API_KEY=
AI_LLM_BASE_URL=
AI_TRANSCRIPTION_PROVIDER=mock  # mock | openai | google | browser
AI_TRANSCRIPTION_MODEL=
AI_TRANSCRIPTION_API_KEY=
AI_TIMEOUT_MS=20000

# Voice (talk to the app). Off until OPENAI_API_KEY is set; the browser talks
# to OpenAI over WebRTC with a short-lived secret minted by the server.
VOICE_ENABLED=true
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
AI_MAX_INPUT_CHARS=1200
AI_MAX_AUDIO_BYTES=8388608
AI_MAX_REQUESTS_PER_HOUR=60
AI_MAX_REQUESTS_PER_DAY=300

# --- GST filing provider (GSP) ---------------------------------------------
# Connected filing stays unavailable until a provider is configured AND
# GSP_PRODUCTION_ENABLED is explicitly true. Sandbox is the default path.
GSP_MODE=unconfigured           # unconfigured | sandbox | production
GSP_PROVIDER_NAME=
GSP_BASE_URL=
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_PRODUCTION_ENABLED=false

# --- PDF rendering ---------------------------------------------------------
# Path to a Chromium binary for the server-side PDF renderer. Leave unset to use
# the one Playwright installs.
PLAYWRIGHT_CHROMIUM_PATH=
